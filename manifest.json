{
  "schemaVersion": 1,
  "id": "com.blogvirtualizado.omaops.pihole",
  "name": "OmaPiHole Monitor",
  "version": "0.2.0",
  "author": "BlogVirtualizado / OmaOps",
  "license": "MIT",
  "description": "Read-only Pi-hole v6 status and DNS blocking metrics for the Omarchy bar.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Pi-hole",
    "description": "Pi-hole health, blocking status and DNS statistics.",
    "category": "System",
    "aliases": ["pihole", "pi-hole", "dns", "omaops"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "baseUrl": "",
      "refreshIntervalSec": 60,
      "staleAfterSec": 180,
      "requestTimeoutMs": 5000,
      "secretId": "default",
      "caCertPath": ""
    },
    "schema": [
      {
        "key": "baseUrl",
        "type": "string",
        "label": "Pi-hole base URL",
        "defaultValue": ""
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 60
      },
      {
        "key": "staleAfterSec",
        "type": "integer",
        "label": "Mark data stale after (seconds)",
        "min": 60,
        "max": 7200,
        "step": 60,
        "defaultValue": 180
      },
      {
        "key": "requestTimeoutMs",
        "type": "integer",
        "label": "HTTP timeout (milliseconds)",
        "min": 1000,
        "max": 30000,
        "step": 1000,
        "defaultValue": 5000
      },
      {
        "key": "secretId",
        "type": "string",
        "label": "Pi-hole application password Secret ID",
        "defaultValue": "default"
      },
      {
        "key": "caCertPath",
        "type": "string",
        "label": "Optional custom CA certificate file (PEM)",
        "defaultValue": ""
      }
    ]
  }
}
