#!/usr/bin/env bash
set -euo pipefail

secret_id="${1:-default}"

if ! command -v secret-tool >/dev/null 2>&1; then
  echo "error: secret-tool not found (install libsecret)" >&2
  exit 1
fi

read -r -s -p "Pi-hole application password: " secret
printf '\n'

if [[ -z "$secret" ]]; then
  echo "error: empty secret; nothing stored" >&2
  exit 1
fi

printf '%s' "$secret" | secret-tool store \
  --label="OmaPiHole (${secret_id})" \
  application omaops-pihole \
  instance "$secret_id"

unset secret
printf 'Stored Pi-hole application password as secret ID: %s\n' "$secret_id"
